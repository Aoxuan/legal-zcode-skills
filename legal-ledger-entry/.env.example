# 复制本文件为 .env（同目录）并填写。真实密钥只放运行机，.env 不入库。
# 平台环境变量同样生效（.env 为本地兜底，不覆盖已存在的环境变量）。

# ===== 飞书自建应用（必填）=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 正式「合同审批单」定义 code（2026-10-26 起直接走正式）。后台页面 id 7241484543487049731 不要传给 API。
FEISHU_APPROVAL_CODE=DB2F122F-9823-4D8E-9D01-7CFC068472FE

# 正式合同台账（2026-10-26 决策：直接写正式台账，录错行人工修正）
FEISHU_LEDGER_APP_TOKEN=LmVHbDXpdaNTK1sTDbjceczrnkh
FEISHU_LEDGER_MAIN_TABLE=tbln45WEECZDdHC3
FEISHU_LEDGER_SUB_TABLE=tbl67Sg7imRboxAG
FEISHU_LEDGER_CATEGORY_TABLE=tblFJBtFnuEr8xE0

# —— 测试副本坐标（本地验收用，正式环境不要改回）——
# FEISHU_APPROVAL_CODE=5D8E981F-1D5E-4C8E-9EA4-5E146B26F890
# FEISHU_LEDGER_APP_TOKEN=<台账副本 app_token，由发放方安全渠道提供>
# FEISHU_LEDGER_MAIN_TABLE=tblTkvIvviA93PYY
# FEISHU_LEDGER_SUB_TABLE=tblmEFt5GivFeTRU
# FEISHU_LEDGER_CATEGORY_TABLE=tblozjjQ8oKZ45Zi

# 使用人。安装时用 bind-user 写入，不要手填手机号。类型固定 user_id。
FEISHU_APPROVER_USER_ID=
FEISHU_APPROVER_USER_ID_TYPE=user_id

# 放行白名单（逗号分隔 user_id）。交付包已预置全体 4 位授权使用人（2026-10-14 定）。
# 每台机器首次绑定只能绑定白名单内用户；换绑/新增其他人需管理员 bind-user --add 显式写入。不要手改。
FEISHU_APPROVER_WHITELIST=73dae83c,b179b536,579ge645,5c76cf3a

# 可选：运行时数据目录（幂等状态 state.json、审计日志 bind_audit.jsonl）。默认写技能内 data/
# LEDGER_WORK_DIR=
