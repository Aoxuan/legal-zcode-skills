# 复制本文件为 .env(同目录)并填写。真实密钥只放运行机,.env 不入库。
# 平台环境变量同样生效(.env 为本地兜底)。

# ===== 飞书自建应用(必填)=====
# 应用凭证:在飞书开发者后台「凭证与基础信息」获取。每个安装者把本租户自建应用
# 的 app_id/app_secret 提供给本技能,填入下方。应用需补开审批相关 scope(见 SKILL.md)。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 合同审批定义 code:在审批后台打开目标审批定义,URL 里的 approvalCode 即此值。
# 多个用逗号分隔。轮询只扫这些定义下 PENDING 的实例。
FEISHU_APPROVAL_CODES=

# 测试流程码(可选):仅 `poll --test` 时扫描测试流程;普通 poll 永远只扫上面的正式码。
# 未配置时 `poll --test` 直接报错,不回退正式码(避免误扫)。
# 测试/正式流程的控件按名称定位(名称一致即可,widget id 不同无影响)。
# FEISHU_APPROVAL_CODES_TEST=

# 审批表单里的候选企业控件(名称或 widget id),多个用逗号分隔。
# 「客户名称」「供应商名称」「达人企业名称」三者互斥、必现其一(都是外部选项单选)。
# 技能从命中的控件同时取出:展示文案「名称｜信用代码｜法人」+ 选项 id(信用代码)。
# 命中的字段值为空(被显示条件隐藏/未填)→ 该实例回填兜底评级文案并放行。
# 不读「对方负责人」(那是联系人,不是工商法人)。
FEISHU_FIELD_COMPANY=客户名称,供应商名称,达人企业名称

# 回填目标控件:【企业风险评级】文本控件名(或 widget id),默认「企业风险评级」。
# 该控件须在「系统风险预审」节点设为非必填 + 可编辑。
FEISHU_FIELD_RATING=企业风险评级
# 回填目标控件:【附件】附件控件名(或 widget id),默认「附件」(attachmentV2)。
# 低/中/高风险都把 Excel 风险报告写入该控件;未知/自然人/兜底只回填评级文本、不动该控件。
# 该控件为技能专用(申请人不传文件):整体设值只保留报告,申请人误传文件一并删除;
# 无报告场景(未知/自然人)若被误传过文件则清空。控件须在「系统风险预审」节点设为可编辑。
# 当前表单用专用控件(申请人不传文件)。控件定位先精确后模糊(控件名须完全包含
# 配置名且配置名>=4字),所以只需配稳定前缀,括号里的说明文案调整不影响匹配:
FEISHU_FIELD_ATTACHMENT=风险报告附件

# 企业风险信息库缓存有效天数;超过则重查企查查。默认 90(近 3 个月)。
FEISHU_CACHE_DAYS=90

# ===== 合同主体一致性校验(2026-10-19 口径)=====
# 校验合同 Word 里实际签约的对方主体与表单企业控件是否一致:
#   供应商名称→合同乙方 / 客户名称→合同甲方 / 达人企业名称→按签约主体排除法;
#   一致才查风险并放行;不一致直接拒绝退回(不查企查查,零计费);
#   附件缺失/解析失败→放行并回填「合同主体未能自动校验，请法务人工核对」。
# 置 0 关闭校验回到旧行为(一律放行)。
FEISHU_SUBJECT_CHECK=1
# 合同 Word 附件控件名(或 widget id),默认「合同附件」(模糊命中带说明后缀的控件名)
FEISHU_FIELD_CONTRACT_ATTACH=合同附件
# 我方「签约主体」控件名(或 widget id),排除法定位合同对方主体的基准
FEISHU_FIELD_OUR_ENTITY=签约主体

# 预审审批账号:本技能以该员工账号同意任务并回填评级/附件。
# 填其 open_id;未填时回退到 FEISHU_COMMENT_USER_ID(同一员工账号)。
# 没有现成 open_id 时,用已开通的 contact:user.id:readonly 按手机号/邮箱反查后再写入。
FEISHU_APPROVER_USER_ID=
# FEISHU_APPROVER_USER_ID_TYPE=open_id

# 可选:轮询时间窗(天),默认 30(仅用于历史兼容,tasks/query 不受此限制)
# FEISHU_QUERY_WINDOW_DAYS=30
# 可选:置 1 时 poll 只取风险、不真正 approve(干跑验收用)
# FEISHU_COMMENT_DRY_RUN=1
# 兼容保留:旧版写评论用;现作为 FEISHU_APPROVER_USER_ID 的回退来源
FEISHU_COMMENT_USER_ID=
# FEISHU_COMMENT_USER_ID_TYPE=open_id

# ===== 企查查开放平台(必填)=====
# 客户账号,全部接口(886/2006/856/739/887/888/889)走这一套
QCC_APP_KEY=
QCC_SECRET_KEY=

# ===== 远程 MySQL(企业查询落库 + dim_company 自然人判定,必填)=====
# 与 legal-person-poll 共库共表:legal_company_query 存风险查询,dim_company 存
# 企业与自然人维度(自然人行 source=自然人信息录入申请表单,身份证号=credit_code=tax_no)。
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
MYSQL_TABLE=legal_company_query

# 可选:运行时数据目录(状态/快照/审计),默认写技能内 data/
# QCC_DATA_DIR=
# 可选:指定 .env 路径
# QCC_ENV_FILE=
