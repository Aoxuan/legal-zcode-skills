# 复制本文件为 .env(同目录)并填写。真实密钥只放运行机,.env 不入库。
# 平台环境变量同样生效(.env 为本地兜底)。

# ===== 飞书自建应用(必填)=====
# 应用凭证:在飞书开发者后台「凭证与基础信息」获取。每个安装者把本租户自建应用
# 的 app_id/app_secret 提供给本技能,填入下方。应用需补开审批相关 scope(见 SKILL.md)。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 合同审批定义 code:在审批后台打开目标审批定义,URL 里的 approvalCode 即此值。
# 多个用逗号分隔。轮询只扫这些定义下 PENDING 的实例。
FEISHU_APPROVAL_CODES=

# 审批表单里对方企业三要素的控件标识。优先用控件「名称」(中文,如"对方企业名称"),
# 若名称有重名或不可靠,改填控件 widget id(在审批定义编辑页查看)。
FEISHU_FIELD_COMPANY_NAME=
FEISHU_FIELD_CREDIT_CODE=
FEISHU_FIELD_LEGAL_PERSON=

# 可选:轮询时间窗(天),默认 30,飞书 instances/query 上限 30 天
# FEISHU_QUERY_WINDOW_DAYS=30
# 本技能始终查企查查最新(约 7.50 元)并写评论,低/中/高都写;不走库缓存。
# 可选:置 1 时 poll 只取风险、不真正写评论(干跑验收用)
# FEISHU_COMMENT_DRY_RUN=1
# 可选:写审批评论时指定发表人(部分租户要求)。open_id / user_id / union_id
# FEISHU_COMMENT_USER_ID=
# FEISHU_COMMENT_USER_ID_TYPE=open_id

# ===== 企查查开放平台(必填)=====
# 主账号(用于 856/739;缺 Monica 时也回退用于 886/2006/887/888/889)
QCC_APP_KEY=
QCC_SECRET_KEY=

# Monica 账号(必填,固定用于 886/2006/887/888/889)
# 两套 Key 都要填,只填一套会查不全。生产账号已开通全部接口时,可只填主账号、删除以下两项。
QCC_APP_KEY_MONICA=
QCC_SECRET_KEY_MONICA=

# ===== 远程 MySQL(企业查询落库,必填)=====
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
MYSQL_TABLE=legal_company_query

# 可选:运行时数据目录(状态/快照/审计),默认写技能内 data/
# QCC_DATA_DIR=
# 可选:指定 .env 路径
# QCC_ENV_FILE=
