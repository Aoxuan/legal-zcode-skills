# 复制本文件为 .env(同目录)并填写。真实密钥只放运行机,.env 不入库。
# 平台环境变量同样生效(.env 为本地兜底)。
# QCC_* 与 MYSQL_* 均为必填;缺 MYSQL_* 时 check/profile 直接失败,不回退。

# 企查查开放平台 - 主账号(用于 856/739;缺 Monica 时也回退用于 886/2006/887/888/889)
QCC_APP_KEY=
QCC_SECRET_KEY=

# 企查查开放平台 - Monica 账号(必填,固定用于 886/2006/887/888/889)
# 两套 Key 都要填,只填一套会查不全。生产账号已开通全部接口时,可只填主账号、删除以下两项。
QCC_APP_KEY_MONICA=
QCC_SECRET_KEY_MONICA=

# 远程 MySQL(企业查询落库,必填)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
MYSQL_TABLE=legal_company_query

# 可选:运行时数据目录(快照/审计),默认写技能内 data/
# QCC_DATA_DIR=
# 可选:指定 .env 路径
# QCC_ENV_FILE=
