# 复制本文件为 .env(同目录)并填写。真实密钥只放运行机,.env 不入库。
# 平台环境变量同样生效(.env 为本地兜底)。
# QCC_* 与 MYSQL_* 均为必填;缺 MYSQL_* 时 check/profile 直接失败,不回退。

# 企查查开放平台 - 客户账号(全部接口走这一套)
QCC_APP_KEY=
QCC_SECRET_KEY=

# 远程 MySQL(企业查询落库,必填)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
MYSQL_TABLE=legal_company_query

# 可选:运行时数据目录(快照/审计),默认写技能内 data/
# QCC_DATA_DIR=
# 可选:指定 .env 路径
# QCC_ENV_FILE=
