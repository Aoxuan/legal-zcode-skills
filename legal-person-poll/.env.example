# 自然人审批采集 legal-person-poll 配置模板
# 复制为 .env 并填入真实值(.env 不入库、不分发)

# ── 飞书自建应用(每位用户用自己的应用凭证,开发者后台-凭证与基础信息 可查) ──
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ── 审批定义:自然人信息录入申请(正式流程) ──
APPROVAL_CODE=F0A86650-2ED3-4468-BAC4-69E8D941B199

# 每轮扫描的时间窗(天),默认 3(最大 ≤30)
WINDOW_DAYS=3

# ── MySQL(共库,已预填;密码由发放方通过安全渠道单独发送,勿写进文档/群聊) ──
MYSQL_HOST=REDACTED_MYSQL_HOST
MYSQL_PORT=28823
MYSQL_USER=REDACTED_MYSQL_USER
MYSQL_PASSWORD=<由发放方安全渠道单独获取>
MYSQL_DB=REDACTED_MYSQL_USER
MYSQL_TABLE=dim_company

# ── 飞书表单控件名 → 字段(须与审批表单控件标题逐字一致,以 test-instance 打印的 form 为准回填) ──
FIELD_PERSON_NAME=自然人姓名
FIELD_ID_CARD=自然人身份证号码
FIELD_PHONE=自然人联系电话
FIELD_ADDRESS=自然人地址
FIELD_LIAISON=我方对接人
